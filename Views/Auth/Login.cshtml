@model RaceDay_Part_3_MVC.Models.LoginRequest

@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h2 class="text-center mb-4" style="color: #0d6efd; font-weight: 800;">RaceDay Login</h2>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Email Address</label>
                        <input asp-for="email" class="form-control" type="email" placeholder="you@example.com" required />
                        <span asp-validation-for="email" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label font-weight-bold">Password</label>
                        <input asp-for="password" class="form-control" type="password" placeholder="Enter your password" required />
                        <span asp-validation-for="password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2" style="font-weight: 600;">Login</button>
                </form>

                <div class="text-center mt-3">
                    <small>Don't have an account? <a asp-action="Register">Register here</a></small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}