@model RaceDay_Part_3_MVC.Models.CreateEventRequest

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Create a New Event</h2>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <<form asp-action="Create" method="post" enctype="multipart/form-data" class="card p-4 shadow-sm">
            <!-- ... existing title, date, location fields ... -->

            <div class="mb-3">
                <label class="form-label">Event Banner Image</label>
                <input type="file" name="bannerFile" class="form-control" accept="image/*" />
                <small class="text-muted">Upload a banner image for the event (Stored in Azure Blob).</small>
            </div>

            <button type="submit" class="btn btn-success w-100 mt-3">Create Event</button>
        </form>
    </div>
</div>