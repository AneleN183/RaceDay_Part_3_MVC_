@model List<RaceDay_Part_3_MVC.Models.EnrolmentViewModel>

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2>Enrolments: @ViewBag.EventTitle</h2>
    <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
</div>

<table class="table table-bordered shadow-sm">
    <thead>
        <tr>
            <th>Participant Name</th>
            <th>Category</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.registration_status == "confirmed")
                    {
                        <span class="badge badge-confirmed px-2 py-1">Confirmed</span>
                    }
                    else if (item.registration_status == "pending")
                    {
                        <span class="badge badge-pending px-2 py-1">Pending</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-2 py-1">@item.registration_status</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>