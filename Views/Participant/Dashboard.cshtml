@model RaceDay_Part_3_MVC.Models.ParticipantDashboardViewModel

<h2 class="mt-4">My Enrolments</h2>
<p class="text-muted">Welcome back, @Model.Name</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row mt-4">
    @foreach (var reg in Model.Registrations)
    {
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-left-primary">
                <div class="card-body">
                    <h4 class="card-title">@reg.event_title</h4>
                    <h6 class="card-subtitle mb-3 text-muted">@reg.event_date.ToString("dd MMM yyyy")</h6>

                    <p>
                        <strong>Status:</strong>
                        @if (reg.registration_status == "confirmed")
                        {
                            <span class="badge badge-confirmed px-2 py-1">Confirmed</span>
                        }
                        else if (reg.registration_status == "pending")
                        {
                            <span class="badge badge-pending px-2 py-1">Pending</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-2 py-1">@reg.registration_status</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    }
</div>