@model List<RaceDay_Part_3_MVC.Models.ParticipantResultViewModel>

<h2 class="mt-4 mb-4">My Race History</h2>

<table class="table table-striped shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Event</th>
            <th>Date</th>
            <th>Category</th>
            <th>Finish Time</th>
            <th>Overall Position</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var res in Model)
        {
            <tr>
                <td>@res.event_title</td>
                <td>@res.event_date.ToString("dd MMM yyyy")</td>
                <td>@res.category_name</td>
                <td>@res.finish_time</td>
                <td>
                    <strong>@res.overall_rank</strong> out of @res.total_finishers finishers
                </td>
            </tr>
        }
    </tbody>
</table>