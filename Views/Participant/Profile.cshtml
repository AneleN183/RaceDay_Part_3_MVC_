@model RaceDay_Part_3_MVC.Models.ProfileViewModel

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <h2>My Profile</h2>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        <form asp-action="Profile" method="post" enctype="multipart/form-data" class="card p-4 shadow-sm">
            <div class="text-center mb-3">
                <img src="https://via.placeholder.com/150" class="rounded-circle mb-2" style="width: 100px; height: 100px; object-fit: cover;" alt="Profile Picture" />
                <input type="file" name="profilePicture" class="form-control" />
            </div>
            <div class="mb-3">
                <label>First Name</label>
                <input asp-for="first_name" class="form-control" />
            </div>
            <div class="mb-3">
                <label>Last Name</label>
                <input asp-for="last_name" class="form-control" />
            </div>
            <div class="mb-3">
                <label>Email</label>
                <input asp-for="email" class="form-control" type="email" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Update Profile</button>
        </form>
    </div>
</div>