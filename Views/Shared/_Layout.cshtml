<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay_Part_3_MVC_</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay_Part_3_MVC_.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Events" asp-action="Index">
                    🏃‍♂️ RaceDay
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <!-- PUBLIC LINKS -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Events" asp-action="Index">Browse Events</a>
                        </li>

                        <!-- LOGGED IN LINKS -->
                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            @if (Context.Session.GetString("UserRole") == "participant")
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Participant" asp-action="Dashboard">My Enrolments</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Participant" asp-action="MyResults">My Results</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Participant" asp-action="Profile">My Profile</a></li>
                            }
                            else if (Context.Session.GetString("UserRole") == "organiser")
                            {
                                <li class="nav-item"><a class="nav-link text-dark font-weight-bold" asp-controller="Events" asp-action="Dashboard">Organiser Dashboard</a></li>
                            }
                        }
                    </ul>

                    <!-- RIGHT SIDE (LOGIN/LOGOUT) -->
                    <ul class="navbar-nav">
                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-muted">Hello, @Context.Session.GetString("UserName")</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm mt-1 ms-2">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Auth" asp-action="Login">Login</a></li>
                            <li class="nav-item"><a class="btn btn-primary btn-sm text-white mt-1 ms-2" asp-controller="Auth" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RaceDay_Part_3_MVC_ - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
